# PostgreSQL connection string. Keep real credentials out of Git.
DATABASE_URL=

# Leave disabled until privacy notice, retention, database migration, and UI consent are reviewed.
COMMUNITY_FEEDBACK_ENABLED=false
COMMUNITY_FEEDBACK_PRIVACY_NOTICE_VERSION=community-feedback-v1

# Generate a unique random secret (at least 32 bytes) per environment.
PARTICIPANT_TOKEN_SECRET=

# Token for reviewing community source submissions via PATCH /api/source-submissions.
# Keep private; do not expose it in NEXT_PUBLIC_* variables.
SOURCE_MODERATION_TOKEN=

# Community source submissions stay disabled until DB migration and abuse controls are ready.
SOURCE_SUBMISSIONS_ENABLED=false
